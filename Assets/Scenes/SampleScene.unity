  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypingTextProviderFactory
  _type: 1
  _predefinedText: "\u0421\u043E\u0432\u0441\u0435\u043C \u0441\u043A\u043E\u0440\u043E \u043D\u0430\u0441 \u0436\u0434\u0435\u0442 \u043E\u043A\u0442\u044F\u0431\u0440\u044C\u0441\u043A\u0438\u0439 \u0432\u043E\u0434\u043E\u043F\u0430\u0434 \u0434\u0435\u043C\u043E-\u0432\u0435\u0440\u0441\u0438\u0439 \u0441 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0433\u043E Next Fest. \u041D\u043E \u044D\u0442\u043E \u043D\u0435 \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u0434\u043E \u044D\u0442\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0442\u044C\u0441\u044F, \u0432\u0435\u0434\u044C \u043E\u043D\u0438 \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C! \u0418 \u0432\u0440\u0435\u043C\u044F \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0432 \u044D\u0442\u043E\u043C \u0438\u0437\u043E\u0431\u0438\u043B\u0438\u0438 \u044F \u043D\u0430\u0445\u043E\u0436\u0443 \u0442\u0435 \u0438\u0433\u0440\u044B, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438 \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F \u043F\u043E\u0431\u043B\u0438\u0436\u0435. \u041F\u0440\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u044D\u0442\u043E\u0433\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u043D\u0438\u0436\u0435"
  _articleUrlApi: https://kknights.com/api/v1/post/5235-valor-mortis/
